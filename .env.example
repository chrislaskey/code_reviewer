# Copy to .env (ignored by git) and fill in. Read by bin/run-on-iphone.

# The Apple developer team that signs the iOS app for a phone, such as
# AB12CD34EF. `cargo tauri info` lists the teams of the certificates on this
# Mac; the free "Personal Team" works too, but its installs expire after 7 days.
APPLE_DEVELOPMENT_TEAM=
