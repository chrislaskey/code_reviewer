# Copy to .env (ignored by git) and fill in. Read by bin/reinstall and bin/dev.

# The Apple developer team that signs the iOS app for a phone, such as
# AB12CD34EF. `cargo tauri info` lists the teams of the certificates on this
# Mac; the free "Personal Team" works too, but its installs expire after 7 days.
APPLE_DEVELOPMENT_TEAM=

# The web server the phone's app syncs with; https://starter-pack.fly.dev
# when left empty.
SYNC_SERVER_URL=

# The web server's settings for bin/dev, a JSON document on one line, not
# quoted; the defaults when left empty. Code Reviewer's: accounts made on
# the server by hand, signed in by password alone, nothing sold.
SERVER_SETTINGS={"features": {"accounts_sign_up": false, "accounts_sign_in_code": false, "accounts_purchasing": false}}
