#!/usr/bin/env bash
#
# Runs the checks a change passes before it is committed: Rust's format,
# Clippy and the dependency audit, the Svelte pages' type check, the
# translations, and the sample Elixir backend's format and compile. Runs
# each, then lists the ones that failed.
#
# Run `bin/lint --help` for the targets and options.

set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

help() {
  cat <<USAGE
Runs the checks a change passes before it is committed.

Usage: $0 [TARGET...] [--fix]

Targets, any number of them, all when none:
  rust           cargo fmt --all -- --check
                 cargo clippy --workspace --all-targets -- -D warnings
                 cargo audit, cargo-audit installed first when missing
  svelte        pnpm check (svelte-check), in svelte/
  translations   pnpm translations:check, in svelte/: translations/default.pot
                 has every message the pages write, and each <locale>.po
                 translates them all, none fuzzy. Needs GNU gettext for --fix.
  elixir         mix format --check-formatted
                 mix compile --warnings-as-errors
                 in core_elixir/, the sample remote backend; among all only
                 while core_elixir/ is there.

Options:
  --fix    Fix what can be fixed first: cargo fmt --all,
           pnpm translations:update and mix format, then check.
  help     Show this help. Also -h and --help.

Tests are not run here: cargo test --workspace --all-targets, and
mix test in core_elixir/, which needs PostgreSQL. The conformance suite
of a remote backend: core/src/app/files/conformance_tests.rs.
USAGE
}

fail() {
  echo "$0: $*" >&2
  exit 2
}

targets=()
fix=false
for argument in "$@"; do
  case "$argument" in
    rust|svelte|translations|elixir) targets+=("$argument") ;;
    --fix) fix=true ;;
    help|-h|--help) help; exit 0 ;;
    *) fail "unknown target or option '$argument'; run \`$0 --help\`" ;;
  esac
done
if [ ${#targets[@]} -eq 0 ]; then
  targets=(rust svelte translations)
  [ -d "$ROOT/core_elixir" ] && targets+=(elixir)
fi

failed=()

# Runs one check, its command echoed first, and notes it when it fails.
check() {
  echo "==> $*"
  if ! "$@"; then
    failed+=("$*")
  fi
}

svelte_dependencies_install() {
  if [ ! -d "$ROOT/svelte/node_modules" ]; then
    (cd "$ROOT/svelte" && pnpm install --frozen-lockfile) || fail "pnpm install failed in svelte/"
  fi
}

# Under asdf, each Rust version needs it installed.
cargo_audit_install() {
  if ! cargo audit --version > /dev/null 2>&1; then
    echo "==> cargo install cargo-audit --locked"
    cargo install cargo-audit --locked || fail "cargo install cargo-audit failed"
  fi
}

# Runs the command in core_elixir/, its dependencies fetched first.
in_core_elixir() {
  (cd "$ROOT/core_elixir" && { [ -d deps ] || mix deps.get; } && "$@")
}

cd "$ROOT" || fail "no folder $ROOT"

for target in "${targets[@]}"; do
  case "$target" in
    rust)
      [ "$fix" = true ] && cargo fmt --all
      check cargo fmt --all -- --check
      check cargo clippy --workspace --all-targets -- -D warnings
      cargo_audit_install
      check cargo audit
      ;;
    svelte)
      svelte_dependencies_install
      check pnpm --dir svelte --silent check
      ;;
    translations)
      svelte_dependencies_install
      [ "$fix" = true ] && pnpm --dir svelte --silent translations:update
      check pnpm --dir svelte --silent translations:check
      ;;
    elixir)
      if [ ! -d "$ROOT/core_elixir" ]; then
        failed+=("elixir: no core_elixir/")
      elif ! command -v mix > /dev/null; then
        failed+=("elixir: mix not installed, \`brew install elixir\`")
      else
        [ "$fix" = true ] && in_core_elixir mix format
        check in_core_elixir mix format --check-formatted
        check in_core_elixir mix compile --warnings-as-errors
      fi
      ;;
  esac
done

if [ ${#failed[@]} -gt 0 ]; then
  echo
  echo "Failed:"
  printf '  %s\n' "${failed[@]}"
  exit 1
fi
echo
echo "All checks passed: ${targets[*]}."
