#!/bin/bash
set -e

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

usage() {
  echo "Usage: bin/dev <tauri|axum>"
  echo ""
  echo "  tauri   Start the Tauri desktop app in dev mode"
  echo "  axum    Start the Axum server and Vite dev server"
  exit 1
}

dev_tauri() {
  cd tauri
  pnpm tauri dev
}

dev_axum() {
  echo "Starting Axum server on http://localhost:3000 ..."
  cargo run -p code_reviewer_axum &
  AXUM_PID=$!

  trap "kill $AXUM_PID 2>/dev/null" EXIT

  echo "Waiting for Axum server to be ready ..."
  for i in $(seq 1 60); do
    if curl -s http://localhost:3000/api/health > /dev/null 2>&1; then
      echo "Axum server is ready."
      break
    fi
    if ! kill -0 $AXUM_PID 2>/dev/null; then
      echo "Error: Axum server exited unexpectedly."
      exit 1
    fi
    sleep 1
  done

  echo "Starting Vite dev server on http://localhost:5173 ..."
  cd axum/web
  pnpm dev

  wait $AXUM_PID
}

case "${1:-}" in
  tauri) dev_tauri ;;
  axum)  dev_axum ;;
  *)     usage ;;
esac
