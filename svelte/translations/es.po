msgid_plural "${ loss.conflicts } changes were not kept by the server."
msgstr[0] "${ loss.conflicts } cambio no lo conservó el servidor."
msgstr[1] "${ loss.conflicts } cambios no los conservó el servidor."

#: src/accounts/components/AccountsRemoveDialog.svelte:41
