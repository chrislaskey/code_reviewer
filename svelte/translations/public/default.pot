msgid "Starter Pack is one application written once and run in three places: a web server, a desktop app and a phone app. The web server is the system of record; each app keeps a copy of what you can see and syncs its changes when it is online."
msgstr ""

#: src/public/about.html:23
msgid "<a href=\"/accounts/sign-in\" class=\"link\">Sign up</a> on the web, then log in from the app on each of your devices."
msgstr ""

#: src/public/index.html:8
msgid "One Rust application on the web, on the desktop and on a phone, working offline."
msgstr ""

