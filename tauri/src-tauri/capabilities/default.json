{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: reviews a repository's changes, traces its tests, lists, creates and opens Claude Code sessions in tmux, and manages remote access",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-list-branches-and-recent-commits",
    "allow-analyze-file-changes",
    "allow-get-function-diffs",
    "allow-get-file-diffs",
    "allow-list-tests",
    "allow-get-test-call-stack",
    "allow-get-session-settings",
    "allow-get-default-session-port",
    "allow-list-sessions",
    "allow-get-session",
    "allow-get-agent-chat-history",
    "allow-send-prompt-to-session",
    "allow-create-session",
    "allow-continue-session",
    "allow-merge-session",
    "allow-close-session",
    "allow-show-session-in-terminal-app",
    "allow-open-session-in-browser",
    "allow-open-session-artifacts-in-browser",
    "allow-get-app-platform",
    "allow-get-remote-access-status",
    "allow-set-remote-access-enabled",
    "allow-create-paired-device",
    "allow-revoke-paired-device",
    "allow-get-pairing-status",
    "allow-pair-with-computer",
    "allow-unpair-from-computer"
  ]
}
